# Copy to .env and fill in. Compose reads this file on the host and passes only
# the variables listed in compose.yaml into the container.

# OpenRouter: used by DeepSeek Harness (dsh) and ARTEX
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# ARTEX's PostgreSQL (only reachable inside the compose network)
POSTGRES_PASSWORD=artex

# Host ports (bound to 127.0.0.1)
# DSH_WEB_PORT=3080
# ARTEX_PORT=8787
# ARTEX_PROXY_PORT=8788

# TZ=Asia/Taipei

# REA's MCP tool catalog is several MB at "full"; compact input + off output schemas keep it within model context.
# REA_MCP_INPUT_SCHEMA_PROFILE=compact
# REA_MCP_OUTPUT_SCHEMA_PROFILE=off
